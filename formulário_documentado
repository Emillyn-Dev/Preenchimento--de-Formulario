def valor_valido(val):
    """
    Verifica se um valor da planilha é considerado preenchido.
    Retorna False para células vazias, NaN, "nan" ou "none" (resíduos do pandas).
    """
    return pd.notna(val) and str(val).strip().lower() not in ("", "nan", "none")


# =========================
# LOOP PRINCIPAL
# =========================
# Percorre todas as linhas da planilha e preenche o formulário para cada uma
# que ainda não tem número de chamado (coluna "chamado" vazia ou com "N/A").

# Listas para o relatório final
linhas_sem_nome = []    # Linhas puladas porque o nome não foi encontrado no sistema
linhas_sem_numero = []  # Linhas processadas mas cujo número não foi capturado (N/A)

# Encontra a primeira linha pendente para exibir progresso correto no terminal
primeira_pendente = None
for index, linha in df.iterrows():
    chamado_vazio = not valor_valido(linha.get("chamado", ""))
    nome_vazio    = not valor_valido(linha.get("nome", ""))

    if chamado_vazio and not nome_vazio:
        primeira_pendente = index
        break

if primeira_pendente is None:
    print("✅ Todas as linhas pendentes já possuem chamado ou estão sem nome. Nada a fazer.")
    driver.quit()
    raise SystemExit

print(f"\n▶ Iniciando a partir da linha {primeira_pendente + 1}\n")

# Loop principal: processa cada linha da planilha
for index, linha in df.iterrows():
    chamado_atual  = str(linha.get("chamado", "")).strip()
    chamado_vazio  = not valor_valido(linha.get("chamado", ""))
    nome_vazio     = not valor_valido(linha.get("nome", ""))

    # Considera "N/A" como pendente: o chamado pode ter sido aberto mas sem número capturado,
    # então tenta novamente na próxima execução
    chamado_pendente = chamado_vazio or chamado_atual == "N/A"

    if not chamado_pendente:
        print(f"⏭ Linha {index + 1} já tem chamado ({chamado_atual}), pulando.")
        continue

    if nome_vazio:
        print(f"⏭ Linha {index + 1} sem nome preenchido, pulando.")
        continue

    nome_da_linha = str(linha.get("nome", "")).strip()
    reprocessando = chamado_atual == "N/A"
    status_label  = "🔁 REPROCESSANDO (era N/A)" if reprocessando else "🔵 Nova solicitação"
    print(f"\n{status_label} {index + 1}/{len(df)} — Nome: {nome_da_linha}")

    # Abre o formulário no navegador e aguarda carregar
    try:
        driver.get(URL)
        aguardar_formulario()
    except Exception as e:
        print(f"  ❌ Erro ao carregar formulário: {e}")
        continue

    nome_encontrado = True  # Flag para controlar se o nome foi encontrado no sistema

    # Preenche cada campo na ordem definida em ORDEM
    for col in ORDEM:
        if col not in df.columns:
            continue  # Pula colunas que não existem na planilha

        valor = linha.get(col, "")
        if not valor_valido(valor):
            continue  # Pula campos vazios na linha atual

        print(f"  → '{col}' = '{valor}'")
        try:
            if col == "nome":
                # Campo especial: busca por pessoa no banco de usuários do ServiceNow
                nome_encontrado = preencher_reference_nome(REFERENCE_NOME, valor)

                if not nome_encontrado:
                    print(f"  ⚠️  Nome '{valor}' não encontrado. Pulando linha {index + 1}...")
                    linhas_sem_nome.append({
                        "linha":  index + 1,
                        "nome":   valor,
                        "motivo": "Nome não encontrado no sistema ServiceNow"
                    })
                    try:
                        driver.get("about:blank")  # Limpa a página para não interferir na próxima
                    except Exception:
                        pass
                    break  # Interrompe o preenchimento desta linha

            elif col == "setor":
                # Campo com lógica de fallback para "adm"
                preencher_reference_setor("s2id_sp_formfield_u_setor", valor)

            elif col == "local":
                # Campo que sempre seleciona a primeira opção disponível
                preencher_reference_local(LOCAL_S2_ID, valor)

            elif col in SELECT2:
                # Campo de lista suspensa padrão
                selecionar_select2(SELECT2[col], valor)

                # Caso especial: após "tipo de servico", aguarda o campo "aplicativo" aparecer,
                # pois ele só é exibido condicionalmente dependendo do tipo selecionado
                if col == "tipo de servico":
                    print("  ⏳ Aguardando campo aplicativo...")
                    try:
                        WAIT_CURTO.until(EC.visibility_of_element_located(
                            (By.ID, "s2id_sp_formfield_selecione_o_programa_aplicativo")
                        ))
                        print("  ✅ Campo aplicativo pronto!")
                    except Exception:
                        pass

            elif col in REFERENCE:
                # Campo de busca referenciada genérico (atualmente não usado, mas disponível)
                preencher_reference(REFERENCE[col], valor)

            elif col in INPUTS:
                # Campo de texto simples (input HTML)
                preencher_input(INPUTS[col], valor)

        except Exception as e:
            print(f"    ❌ Erro no campo '{col}': {e}")
            fechar_dropdown()  # Garante que nenhum dropdown fique aberto após erro

    if not nome_encontrado:
        continue  # Pula para a próxima linha se o nome não foi encontrado

    # Envia o formulário clicando no botão "Enviar"
    print("  → Enviando formulário...")
    try:
        submit = WAIT_LONGO.until(EC.element_to_be_clickable((By.ID, "submit-btn")))
        clicar(submit)
    except Exception as e:
        print(f"  ❌ Erro ao enviar: {e}")
        continue

    # Captura o número do chamado gerado e salva na planilha
    protocolo = capturar_protocolo()
    df.at[index, "chamado"] = protocolo
    print(f"  ✅ Chamado: {protocolo}")

    # Registra para o relatório final se o número não foi capturado
    if protocolo == "N/A":
        linhas_sem_numero.append({"linha": index + 1, "nome": nome_da_linha})

    salvar_planilha()  # Salva imediatamente após cada chamado (evita perda de dados)

    # Navega de volta ao formulário para o próximo registro
    if index < len(df) - 1:
        print("  🔄 Próximo chamado...")
        driver.back()
        try:
            aguardar_formulario()
        except Exception:
            # Se o "back" não levou ao formulário, acessa a URL diretamente
            driver.get(URL)
            aguardar_formulario()

# Encerra o navegador após processar todas as linhas
driver.quit()
