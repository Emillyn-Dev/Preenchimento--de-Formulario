def selecionar_select2(id_container_s2, texto_opcao):
    """
    Preenche um campo Select2 de lista fixa (opções pré-definidas, não busca no servidor).
    Abre o dropdown, digita o texto para filtrar e seleciona a opção correspondente.
    Se não encontrar correspondência exata, seleciona a primeira opção disponível.

    Usado para campos como: usuário, localizado, gerente, serviço TI etc.
    """
    texto_opcao = str(texto_opcao).strip()

    # Aguarda o container do Select2 estar visível antes de interagir
    try:
        WAIT_CURTO.until(EC.visibility_of_element_located((By.ID, id_container_s2)))
    except Exception:
        pass

    if not abrir_select2(id_container_s2):
        print(f"    ❌ Não conseguiu abrir '{id_container_s2}'")
        return

    search = obter_search_input()
    if search:
        _digitar_no_search(search, texto_opcao)

    visiveis = aguardar_opcoes_dropdown(timeout=4)
    selecionou = False

    if visiveis:
        # Procura a opção com texto exatamente igual ao da planilha
        for opcao in visiveis:
            if opcao.text.strip().lower() == texto_opcao.lower():
                clicar(opcao)
                print(f"    ✅ Selecionado: '{opcao.text.strip()}'")
                selecionou = True
                break
        # Se não encontrou exato, seleciona a primeira opção (fallback)
        if not selecionou:
            clicar(visiveis[0])
            print(f"    ⚠️  '{texto_opcao}' não encontrado — selecionou '{visiveis[0].text.strip()}'")
            selecionou = True
    else:
        print(f"    ❌ Nenhuma opção visível para '{texto_opcao}'")

    fechar_dropdown()
    if selecionou:
        aguardar_selecao_confirmada(id_container_s2)


def preencher_reference(id_container_s2, texto):
    """
    Preenche um campo Select2 do tipo "reference" (busca no servidor ao digitar).
    Digita o texto, aguarda as sugestões do servidor e seleciona a melhor correspondência.
    Usa match por colunas para lidar com opções que exibem múltiplas informações.
    """
    texto = str(texto).strip()

    if not abrir_select2(id_container_s2):
        print(f"    ❌ Não conseguiu abrir '{id_container_s2}'")
        return

    search = obter_search_input()
    if search is None:
        print(f"    ❌ Campo de busca não apareceu para '{id_container_s2}'")
        fechar_dropdown()
        return

    _digitar_no_search(search, texto)
    visiveis = aguardar_opcoes_dropdown(timeout=5)

    selecionou = False
    if visiveis:
        selecionou = _selecionar_por_celulas(visiveis, texto)
        if not selecionou:
            # Fallback: seleciona a primeira opção se não houver correspondência
            clicar(visiveis[0])
            print(f"    ⚠️  '{texto}' não encontrado — selecionou primeiro: '{visiveis[0].text.strip()}'")
            selecionou = True
    else:
        try:
            search.send_keys(Keys.ESCAPE)
        except Exception:
            pass
        print(f"    ⚠️  Sem sugestão para '{texto}'")

    fechar_dropdown()
    if selecionou:
        aguardar_selecao_confirmada(id_container_s2)


def preencher_reference_local(id_container_s2, texto):
    """
    Preenche o campo "local" (unidade hospitalar).
    Diferente dos outros campos, sempre seleciona a PRIMEIRA opção que aparecer,
    sem tentar correspondência exata — pois os nomes no sistema podem ter formatação
    diferente da planilha (ex: siglas vs nome completo).

    A pausa de 1.5s é necessária porque a busca de local é mais lenta no servidor.
    """
    texto = str(texto).strip()

    if not abrir_select2(id_container_s2):
        print(f"    ❌ Não conseguiu abrir '{id_container_s2}'")
        return

    search = obter_search_input()
    if search is None:
        print(f"    ❌ Campo de busca não apareceu para '{id_container_s2}'")
        fechar_dropdown()
        return

    _digitar_no_search(search, texto)
    time.sleep(1.5)  # Aguarda a resposta do servidor para o campo de local

    visiveis = aguardar_opcoes_dropdown(timeout=8)

    if not visiveis:
        print(f"    ⚠️  Nenhuma sugestão para '{texto}' no campo local")
        try:
            search.send_keys(Keys.ESCAPE)
        except Exception:
            pass
        fechar_dropdown()
        return

    # Sempre seleciona a primeira opção, sem verificar correspondência
    primeira = visiveis[0]
    print(f"    → Primeira opção disponível: '{primeira.text.strip()}'")
    clicar(primeira)
    print(f"    ✅ Local selecionado: '{primeira.text.strip()}'")

    fechar_dropdown()
    aguardar_selecao_confirmada(id_container_s2)


def preencher_reference_nome(id_container_s2, texto):
    """
    Preenche o campo "nome" (pessoa solicitante) no formulário.
    Faz a busca no servidor e tenta correspondência em duas etapas:
      1. Pelo NOME COMPLETO (primeira coluna da opção)
      2. Pelo E-MAIL (prefixo antes do @, segunda coluna)

    Se nenhuma correspondência for encontrada, retorna False e a linha é pulada.
    Tem uma segunda tentativa automática caso o servidor demore a responder.

    Retorna True se encontrou e selecionou a pessoa, False caso contrário.
    """
    texto = str(texto).strip()

    if not abrir_select2(id_container_s2):
        print(f"    ❌ Não conseguiu abrir '{id_container_s2}'")
        return False

    search = obter_search_input()
    if search is None:
        print(f"    ❌ Campo de busca não apareceu para '{id_container_s2}'")
        fechar_dropdown()
        return False

    _digitar_no_search(search, texto)

    # Aguarda até 8 segundos pelas sugestões do servidor
    # (aumentado de 5s pois o servidor pode demorar mais)
    visiveis = aguardar_opcoes_dropdown(timeout=8)

    if not visiveis:
        # Segunda tentativa: às vezes o campo precisa de um segundo estímulo
        print(f"    ⚠️  Sem sugestões na 1ª tentativa — tentando novamente...")
        _digitar_no_search(search, texto)
        time.sleep(1.0)
        visiveis = aguardar_opcoes_dropdown(timeout=8)

    if not visiveis:
        print(f"    ❌ Nome '{texto}' não encontrado no sistema (sem sugestões)")
        try:
            search.send_keys(Keys.ESCAPE)
        except Exception:
            pass
        fechar_dropdown()
        return False

    selecionou = False
    texto_lower = texto.lower()

    # Tentativa 1: correspondência exata pelo NOME (primeira coluna do resultado)
    for li in visiveis:
        try:
            celulas = li.find_elements(By.CSS_SELECTOR, "div.select2-result-cell")
            col1 = celulas[0].text.strip() if celulas else ""
            if col1.lower() == texto_lower:
                clicar(li)
                print(f"    ✅ Selecionado pelo nome: '{col1}'")
                selecionou = True
                break
        except Exception:
            continue

    # Tentativa 2: correspondência pelo E-MAIL (segunda coluna, parte antes do @)
    if not selecionou:
        for li in visiveis:
            try:
                celulas = li.find_elements(By.CSS_SELECTOR, "div.select2-result-cell")
                col2 = celulas[1].text.strip() if len(celulas) >= 2 else ""
                prefixo = col2.split("@")[0] if "@" in col2 else col2
                if prefixo.lower() == texto_lower:
                    clicar(li)
                    print(f"    ✅ Selecionado pelo e-mail: '{col2}'")
                    selecionou = True
                    break
            except Exception:
                continue

    if not selecionou:
        # Mostra as opções disponíveis no terminal para facilitar a correção manual
        resumo = []
        for li in visiveis[:5]:
            try:
                celulas = li.find_elements(By.CSS_SELECTOR, "div.select2-result-cell")
                c1 = celulas[0].text.strip() if celulas else ""
                c2 = celulas[1].text.strip() if len(celulas) >= 2 else ""
                resumo.append(f"[{c1} | {c2}]")
            except Exception:
                resumo.append(li.text.strip())
        print(f"    ❌ Sem correspondência exata para '{texto}'. Opções: {resumo}")
        try:
            search.send_keys(Keys.ESCAPE)
        except Exception:
            pass
        fechar_dropdown()
        return False

    fechar_dropdown()
    aguardar_selecao_confirmada(id_container_s2)
    return True


def preencher_reference_setor(id_container_s2, texto):
    """
    Preenche o campo "setor".
    Tenta encontrar o setor exato primeiro.
    Se não encontrar, usa "adm" como termo de busca alternativo (fallback)
    e seleciona a primeira opção disponível.

    ⚠️  ALTERE AQUI ao reutilizar:
    O fallback "adm" é específico para este formulário da Rede D'Or.
    Troque por outro termo genérico que faça sentido no seu contexto.
    """
    texto = str(texto).strip()

    if not abrir_select2(id_container_s2):
        print(f"    ❌ Não conseguiu abrir '{id_container_s2}'")
        return

    search = obter_search_input()
    if search is None:
        print(f"    ❌ Campo de busca não apareceu para '{id_container_s2}'")
        fechar_dropdown()
        return

    _digitar_no_search(search, texto)
    visiveis = aguardar_opcoes_dropdown(timeout=4)
    selecionou = _selecionar_por_celulas(visiveis, texto) if visiveis else False

    if not selecionou:
        # Fallback: busca por "adm" e seleciona a primeira opção
        print(f"    ⚠️  '{texto}' não encontrado — fallback: digitando 'adm' e selecionando 1ª opção...")
        _digitar_no_search(search, "adm")  # ⚠️  Altere "adm" se necessário
        time.sleep(1.0)
        visiveis = aguardar_opcoes_dropdown(timeout=6)

        if visiveis:
            primeira = visiveis[0]
            print(f"    → Primeira opção disponível: '{primeira.text.strip()}'")
            clicar(primeira)
            print(f"    ✅ Setor selecionado (fallback): '{primeira.text.strip()}'")
            selecionou = True
        else:
            print(f"    ❌ Nenhuma opção encontrada nem com 'adm'.")
            try:
                search.send_keys(Keys.ESCAPE)
            except Exception:
                pass

    fechar_dropdown()
    if selecionou:
        aguardar_selecao_confirmada(id_container_s2)


def preencher_input(id_campo, valor):
    """
    Preenche um campo de texto simples (input HTML comum, não Select2).
    Aguarda o campo estar clicável, limpa o conteúdo anterior e digita o valor.
    Usado para campos como: telefone, setor de instalação e descrição.
    """
    fechar_dropdown()  # Fecha qualquer dropdown aberto antes de interagir
    el = WAIT_MEDIO.until(EC.element_to_be_clickable((By.ID, id_campo)))
    el.clear()
    el.send_keys(str(valor).strip())


def capturar_protocolo():
    """
    Tenta capturar o número do chamado (RITM/REQ/INC/CHG) após o envio do formulário.
    Usa 4 estratégias em ordem crescente de complexidade:

      1. Título da janela do navegador (mais rápido — o ServiceNow atualiza o <title> primeiro)
      2. Links CSS com o número na página de confirmação
      3. Texto genérico em elementos da página
      4. URL atual do navegador

    Se nenhuma estratégia funcionar, retorna "N/A" e avisa o usuário.
    Linhas com "N/A" são reprocessadas automaticamente na próxima execução.

    ⚠️  ALTERE AQUI ao reutilizar em outro sistema:
    Os prefixos RITM, REQ, INC, CHG são padrão do ServiceNow.
    Troque pelos padrões de número do seu sistema.
    """

    # Estratégia 1: título da janela (mais rápido e confiável)
    try:
        WebDriverWait(driver, 10).until(
            lambda d: re.search(r"(RITM|REQ|INC|CHG)\d+", d.title, re.IGNORECASE)
        )
        match = re.search(r"(RITM|REQ|INC|CHG)\d+", driver.title, re.IGNORECASE)
        if match:
            print(f"  📋 Protocolo (título): {match.group(0)}")
            return match.group(0)
    except Exception:
        pass

    # Estratégia 2: seletores CSS específicos na página de confirmação
    # Timeout de 25s pois páginas lentas podem demorar para renderizar o número
    seletores_ritm = [
        "td.wrapper-md a[title^='RITM']",
        "td.wrapper-md a[title^='REQ']",
        "td.wrapper-md a[href*='sc_req_item']",
        "a[title^='RITM']",
        "a[title^='REQ']",
    ]
    for seletor in seletores_ritm:
        try:
            WebDriverWait(driver, 25).until(EC.presence_of_element_located((By.CSS_SELECTOR, seletor)))
            el = driver.find_element(By.CSS_SELECTOR, seletor)
            numero = el.get_attribute("title") or el.text.strip()
            if re.match(r"(RITM|REQ|INC|CHG)\d+", numero, re.IGNORECASE):
                print(f"  📋 Protocolo: {numero}")
                return numero
        except Exception:
            continue

    # Estratégia 3: busca por texto em elementos genéricos da página
    seletores_texto = [
        "h1.page-header", "div.panel-heading h1", "span.outputmsg_text",
        "div#outputmsg", "div.request-number", "h2",
        ".form-group .form-control-static",
    ]
    for seletor in seletores_texto:
        try:
            for el in driver.find_elements(By.CSS_SELECTOR, seletor):
                match = re.search(r"(RITM|REQ|INC|CHG|TASK)\d+", el.text.strip(), re.IGNORECASE)
                if match:
                    return match.group(0)
        except Exception:
            continue

    # Estratégia 4: tenta extrair o número da URL atual
    match = re.search(r"(RITM|REQ|INC)\d+", driver.current_url, re.IGNORECASE)
    if match:
        return match.group(0)

    # Nenhuma estratégia funcionou — o chamado provavelmente foi aberto,
    # mas o número não pôde ser lido automaticamente
    print("  ⚠️  ATENÇÃO: chamado enviado mas número não capturado automaticamente.")
    print("              Verifique manualmente no ServiceNow e corrija a planilha.")
    return "N/A"


