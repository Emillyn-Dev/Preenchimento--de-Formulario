def aguardar_formulario():
    """
    Aguarda o formulário estar completamente carregado e pronto para interação.
    Verifica que o botão de envio ("submit-btn") está visível e clicável.
    A pausa de 1.5s é necessária para os campos Select2 terminarem de inicializar —
    sem ela, o campo "nome" pode não retornar sugestões mesmo com o nome correto.
    """
    print("  ⏳ Aguardando formulário...")
    WAIT_LONGO.until(EC.presence_of_element_located((By.ID, "submit-btn")))
    WAIT_LONGO.until(EC.element_to_be_clickable((By.ID, "submit-btn")))
    time.sleep(1.5)  # Aguarda inicialização completa dos campos Select2
    print("  ✅ Formulário pronto!")


def fechar_dropdown():
    """
    Fecha o dropdown Select2 se estiver aberto.
    Tenta primeiro com a tecla ESC; se ainda estiver aberto, clica no body da página.
    Não faz nada se nenhum dropdown estiver visível.
    """
    try:
        drops = driver.find_elements(By.CSS_SELECTOR, ".select2-drop-active")
        if not any(d.is_displayed() for d in drops):
            return  # Nenhum dropdown aberto, nada a fazer
        ActionChains(driver).send_keys(Keys.ESCAPE).perform()
        drops = driver.find_elements(By.CSS_SELECTOR, ".select2-drop-active")
        if any(d.is_displayed() for d in drops):
            driver.find_element(By.TAG_NAME, "body").click()
    except Exception:
        pass  # Ignora erros silenciosamente


def clicar(elemento):
    """
    Clica em um elemento da página de forma robusta.
    Primeiro tenta o clique padrão com ActionChains (move o mouse até o elemento).
    Se falhar (elemento fora da tela ou obstruído), usa JavaScript para rolar a
    página até o elemento e clicar via script.
    """
    try:
        ActionChains(driver).move_to_element(elemento).click().perform()
    except Exception:
        driver.execute_script("arguments[0].scrollIntoView(true); arguments[0].click();", elemento)


def dropdown_aberto():
    """
    Verifica se algum dropdown Select2 está visível no momento.
    Retorna True se aberto, False caso contrário.
    """
    try:
        drops = driver.find_elements(By.CSS_SELECTOR, ".select2-drop-active")
        return any(d.is_displayed() for d in drops)
    except Exception:
        return False


def abrir_select2(id_container_s2):
    """
    Tenta abrir um campo dropdown Select2 usando 4 estratégias diferentes,
    em ordem crescente de complexidade. Retorna True se conseguiu abrir.

    Estratégias:
      1. Clica no link padrão do Select2 (elemento <a> com classe select2-choice)
      2. Clica no container externo do Select2
      3. Abre via jQuery (para casos em que o clique não funciona)
      4. Foca no input interno e pressiona ESPAÇO

    ⚠️  Raramente precisa ser alterado — só se o site trocar a versão do Select2.
    """
    select_id = id_container_s2.replace("s2id_", "", 1)  # Remove o prefixo "s2id_" para obter o ID real
    fechar_dropdown()  # Garante que nenhum outro dropdown está aberto

    # Estratégia 1: Link padrão
    try:
        link = driver.find_element(By.CSS_SELECTOR, f"#{id_container_s2} a.select2-choice")
        clicar(link)
        if dropdown_aberto():
            return True
    except Exception:
        pass

    # Estratégia 2: Container externo
    try:
        container = driver.find_element(By.ID, id_container_s2)
        clicar(container)
        if dropdown_aberto():
            return True
    except Exception:
        pass

    # Estratégia 3: Via jQuery (executa JavaScript direto no navegador)
    try:
        driver.execute_script(f'$("#{select_id}").select2("open");')
        if dropdown_aberto():
            return True
    except Exception:
        pass

    # Estratégia 4: Foca no input interno e pressiona ESPAÇO
    try:
        focusser = driver.find_element(By.CSS_SELECTOR, f"#{id_container_s2} input.select2-focusser")
        driver.execute_script("arguments[0].focus();", focusser)
        ActionChains(driver).send_keys_to_element(focusser, Keys.SPACE).perform()
        if dropdown_aberto():
            return True
    except Exception:
        pass

    return False  # Nenhuma estratégia funcionou


def obter_search_input():
    """
    Retorna o campo de texto de busca do dropdown Select2 que estiver visível.
    Esse campo é onde o texto é digitado para filtrar as opções.
    """
    try:
        els = driver.find_elements(By.CSS_SELECTOR, "input[id^='s2id_autogen'][id$='_search']")
        visiveis = [e for e in els if e.is_displayed()]
        return visiveis[0] if visiveis else None
    except Exception:
        return None


def aguardar_opcoes_dropdown(timeout=5):
    """
    Aguarda as opções do dropdown aparecerem, sem usar sleep fixo.
    Verifica a cada 80ms usando 3 seletores CSS diferentes (do mais específico ao mais genérico).
    Retorna a lista de opções visíveis assim que encontrar alguma, ou lista vazia se
    o timeout esgotar.

    Parâmetro:
      timeout: segundos máximos de espera (padrão: 5)
    """
    seletores = [
        ".select2-results li.select2-result-selectable",
        ".select2-drop-active li.select2-result-selectable",
        ".select2-results li",
    ]
    fim = time.monotonic() + timeout
    while time.monotonic() < fim:
        for seletor in seletores:
            try:
                opcoes = driver.find_elements(By.CSS_SELECTOR, seletor)
                visiveis = [o for o in opcoes if o.is_displayed() and o.text.strip()]
                if visiveis:
                    return visiveis
            except Exception:
                pass
        time.sleep(0.08)  # Poll mínimo para não travar a CPU
    return []  # Timeout esgotado, nenhuma opção encontrada


def aguardar_selecao_confirmada(id_container_s2, timeout=8):
    """
    Aguarda o Select2 exibir um valor selecionado (diferente de placeholder vazio).
    Confirma visualmente que a seleção foi registrada pelo formulário.
    Retorna True se confirmado dentro do timeout, False caso contrário.

    Parâmetro:
      timeout: segundos máximos de espera (padrão: 8)
    """
    # Textos que indicam que nenhuma opção foi selecionada ainda
    placeholders = {"selecione", "select", "", "selecione...", "select...", "carregando..."}
    try:
        WebDriverWait(driver, timeout).until(
            lambda d: d.find_element(
                By.CSS_SELECTOR, f"#{id_container_s2} .select2-chosen"
            ).text.strip().lower() not in placeholders
        )
        valor = driver.find_element(
            By.CSS_SELECTOR, f"#{id_container_s2} .select2-chosen"
        ).text.strip()
        print(f"    ✅ Confirmado: '{valor}'")
        return True
    except Exception:
        print(f"    ⚠️  Seleção não confirmada em '{id_container_s2}', seguindo...")
        return False


def _digitar_no_search(search, texto):
    """
    Limpa o campo de busca do Select2 e digita o texto desejado.
    Usa JavaScript para limpar (mais confiável que .clear() em Select2).
    """
    driver.execute_script("arguments[0].focus(); arguments[0].value = '';", search)
    search.send_keys(texto)


def _selecionar_por_celulas(visiveis, texto):
    """
    Tenta selecionar uma opção do dropdown comparando o texto com cada "célula"
    de uma linha (pois algumas opções têm múltiplas colunas separadas por tabs/espaços).

    Primeira passagem: busca correspondência EXATA (case-insensitive).
    Segunda passagem: busca correspondência PARCIAL (o texto está contido na opção).

    Retorna True se selecionou alguma opção, False caso contrário.
    """
    texto_lower = texto.lower()

    # Tentativa 1: correspondência exata em alguma coluna
    for opcao in visiveis:
        partes = re.split(r'\s{2,}|\t', opcao.text.strip())  # Divide por 2+ espaços ou tab
        colunas = [p.strip() for p in partes if p.strip()]
        if any(c.lower() == texto_lower for c in colunas):
            clicar(opcao)
            print(f"    ✅ Selecionado (exato): '{opcao.text.strip()}'")
            return True

    # Tentativa 2: correspondência parcial em alguma coluna
    for opcao in visiveis:
        partes = re.split(r'\s{2,}|\t', opcao.text.strip())
        colunas = [p.strip() for p in partes if p.strip()]
        if any(texto_lower in c.lower() for c in colunas):
            clicar(opcao)
            print(f"    ✅ Selecionado (parcial): '{opcao.text.strip()}'")
            return True

    return False


