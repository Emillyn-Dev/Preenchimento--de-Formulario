def normalizar(texto):
    """
    Converte um texto para formato padronizado:
    remove acentos, converte para minúsculas e elimina espaços nas bordas.
    Exemplo: 'Ação'  →  'acao'
    Usado para comparar nomes de colunas sem se preocupar com capitalização ou acentos.
    """
    return (
        unicodedata.normalize("NFKD", str(texto))
        .encode("ascii", errors="ignore")
        .decode("utf-8")
        .lower()
        .strip()
    )


# Lê a planilha sem definir cabeçalho ainda (header=None),
# tratando tudo como string para evitar conversões automáticas indesejadas
df_raw = pd.read_excel(PLANILHA, sheet_name=SHEET, header=None, dtype=str)

# Detecta automaticamente qual linha contém o cabeçalho da tabela:
# procura a primeira linha com 5 ou mais colunas preenchidas
header_row = None
for i, row in df_raw.iterrows():
    colunas = [str(v).strip() for v in row.values if pd.notna(v) and str(v).strip() != ""]
    if len(colunas) >= 5:
        header_row = i
        break

if header_row is None:
    print("❌ Não foi possível detectar o cabeçalho da planilha.")
    raise SystemExit

# Relê a planilha agora usando a linha de cabeçalho detectada
df = pd.read_excel(PLANILHA, sheet_name=SHEET, header=header_row, dtype=str)

# Normaliza os nomes das colunas (remove acentos, minúsculas, sem espaços extras)
df.columns = [normalizar(col) for col in df.columns]

# Remove linhas completamente vazias e reinicia os índices
df = df.dropna(how="all").reset_index(drop=True)

# Exibe no terminal as colunas encontradas para conferência
